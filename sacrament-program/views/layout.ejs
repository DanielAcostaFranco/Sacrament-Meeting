<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sacrament Program Builder</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <% if (typeof printMode !== "undefined" && printMode) { %>
    <link rel="stylesheet" href="/css/print.css" />
  <% } %>
</head>
<body>
  <header class="topbar no-print">
    <div class="container topbar-inner">
      <a class="brand" href="/">Sacrament Program</a>
      <nav class="nav">
        <a href="/programs/new">New</a>
        <a href="/programs">History</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <%- body %>
  </main>

  <footer class="footer no-print">
    <div class="container">
      <small>Built with Node + Express + SQLite</small>
    </div>
  </footer>
</body>
</html>
